# Port, auf dem der Relay lokal lauscht (auf Render wird PORT von der Plattform vorgegeben)
PORT=8787

# Der ECHTE OpenAI-Key. Liegt AUSSCHLIESSLICH hier, nie im server/-Deployment.
# Lokal zum Testen: leer lassen und /healthz + Auth-Verhalten ohne echten OpenAI-Call testen,
# oder einen Test-Key eintragen, wenn ein echter Verbindungstest gewünscht ist.
OPENAI_API_KEY=

# Geteiltes Secret, mit dem sich server/ (via AI_RELAY_SHARED_SECRET) hier authentifiziert.
# Muss auf beiden Seiten (hier UND in server/.env als AI_RELAY_SHARED_SECRET) exakt gleich sein.
# Erzeugen z.B. mit: openssl rand -hex 32
RELAY_SHARED_SECRET=

# Optional: Rate-Limit anpassen (Standard: 30 Requests/Minute pro IP)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=30
