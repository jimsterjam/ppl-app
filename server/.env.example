# Vorlage für server/.env (lokale Entwicklung). Kopieren nach server/.env und ausfüllen.
# Nur Variablennamen und Platzhalter - hier NIE echte Werte eintragen und nie committen.
# Produktionswerte stehen in den Render-Umgebungsvariablen (ppl-app-server).
# Quellen: server/utils/validateEnv.js und process.env.*-Nutzung im Server-Code.
# Angegebene Standardwerte gelten, wenn die Variable fehlt.

# --- Pflicht ---------------------------------------------------------------
# MongoDB-Verbindung (mongodb:// oder mongodb+srv://)
MONGO_URI=

# --- Server ----------------------------------------------------------------
# PORT=3001
# HOST=0.0.0.0
# NODE_ENV=development
# LOG_TO_FILE=0

# --- Firebase / Login ------------------------------------------------------
# Service-Account als JSON-String (Firebase Admin)
FIREBASE_ADMIN_CREDENTIAL_JSON=
FIREBASE_PROJECT_ID=
# Web-API-Key (Fallback: VITE_FIREBASE_API_KEY)
# FIREBASE_WEB_API_KEY=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_SERVER_CLIENT_ID=
# GOOGLE_SERVER_CLIENT_SECRET=
# Verifizierungsmail erneut senden: Zeitfenster / Maximum / Cache / Limit abschalten (1)
# RESEND_VERIFICATION_WINDOW_MS=3600000
# RESEND_VERIFICATION_MAX=
# RESEND_VERIFICATION_CACHE_TTL_MS=900000
# RESEND_VERIFICATION_DISABLE_RATE_LIMIT=0
# Mail-Links in Produktion in den Logs zeigen (nur zum Testen)
# SHOW_EMAIL_LINKS=0

# --- CORS ------------------------------------------------------------------
# Kommagetrennte Liste erlaubter Origins
# ALLOWED_ORIGINS=
# CORS_ALLOWED_ORIGINS=
# Im Dev-Modus LAN-Zugriff erlauben (0 = aus)
# CORS_ALLOW_LAN=1

# --- Admin -----------------------------------------------------------------
# Schlüssel für Admin-Routen (Header x-admin-key)
# ADMIN_API_KEY=
# Kommagetrennte Firebase-UIDs mit Admin-Zugriff (z. B. Verifier-Protokoll)
# ADMIN_UIDS=

# --- KI-Feedback -----------------------------------------------------------
# openai | ollama
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# Alternativ über den Relay (dann kein OPENAI_API_KEY auf diesem Server nötig)
# AI_RELAY_URL=
# AI_RELAY_SHARED_SECRET=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=30000
# AI_OPENAI_TIMEOUT_MS=15000
# AI_RETRY_ATTEMPTS=1
# AI_RETRY_BASE_DELAY_MS=700
# AI_BURST_LIMIT_WINDOW_MS=60000
# AI_BURST_LIMIT_MAX_REQUESTS=6
# Prüfung der Zahlen im KI-Text: off | active (Absprache: active)
# AI_VERIFIER_MODE=off
# Schwellen für Vergleichs-Feedback (Produktion: 8 / 28)
# AI_FEEDBACK_MIN_REPETITIONS=
# AI_FEEDBACK_MIN_HISTORY_DAYS=
# AI_REMOTE_ENABLED=false
# AI_REQUIRE_AUTH=true
# AI_REMOTE_ALLOW_TEST=false
# AI_REMOTE_BETA_USERS=
# AI_DEMO_FALLBACK=true
# Rate-Limit Stillstand-Diagnose
# DIAGNOSIS_RATE_LIMIT_MAX=20
# Lokaler Ollama-Provider (nur im Heimnetz erreichbar)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_TIMEOUT_MS=120000

# --- Abo / Workouts / Übungen ----------------------------------------------
# Abo-Plan erzwingen (nur Test): Plan, Geltungsbereich (all|allowlist), Allowlist
# SUBSCRIPTION_FORCE_PLAN=
# SUBSCRIPTION_FORCE_SCOPE=all
# SUBSCRIPTION_FORCE_ALLOWLIST=
# Stunden, wie lange ein abgeschlossenes Workout editierbar bleibt
# WORKOUT_EDIT_WINDOW_HOURS=24
# Übungskatalog: Kuratierung / Filter für exotische Übungen (0 = aus)
# EXERCISE_CURATION_ENABLED=1
# EXERCISE_EXOTIC_FILTER_ENABLED=1
