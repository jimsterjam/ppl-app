{
  "name": "bro-split-app",
  "version": "1.0.0",
  "scripts": {
    "server": "cd server && npx nodemon server.js",
    "server:prod": "cd server && node server.js",
    "client": "cd client && npm run dev",
    "dev": "./dev-stable.sh",
    "dev:old": "concurrently \"npm run server\" \"npm run client\"",
    "dev:basic": "./dev.sh",
    "start:server": "cd server && node server.js",
    "start:client": "cd client && npm run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier -w .",
    "build": "cd client && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.3.0",
    "eslint-plugin-vue": "^10.5.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0"
  }
}
